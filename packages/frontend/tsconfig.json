{
  "compilerOptions": {
    "baseUrl": "./",
    "composite": true,
    "noEmit": true,
    "outDir": "./build/",
    "paths": { "~/*": ["./app/*"] },
    "rootDirs": ["./", "./.react-router/types"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": [
      "@react-router/node",
      "@vitest/browser/providers/playwright",
      "node",
      "vite/client",
      "vitest/globals"
    ]
  },
  "extends": [
    "../../tsconfig.json",
    "@tsconfig/remix/tsconfig.json",
    // "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/vite-react/tsconfig.json"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    ".react-router/types/**/*",
    "resources/locales/**/*.json"
  ]
}
