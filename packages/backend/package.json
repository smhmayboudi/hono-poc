  },
  "scripts": {
    "build": "npm run build:esbuild:pre-push",
    "build:esbuild": "npm run build:esbuild:pre && node --env-file=.env --import=tsx ./script/esbuild.build.ts",
    "build:esbuild:pre": "rimraf ./build/ ./node_modules/.tmp/tsconfig.node.tsbuildinfo && mkdir ./build/ && cp ./package.build.json ./build/package.json && npm run build:tsc",
    "build:esbuild:pre-push": "npm run build:esbuild:pre && node --import=tsx ./script/esbuild.build.pre-push.ts",
    "build:rollup": "npm run build:rollup:pre && npm exec rollup -- --config rollup.config.ts --configPlugin typescript",
    "build:rollup:pre": "rimraf ./build/ && mkdir ./build/ && npm run build:tsc",
    "build:tsc": "tsc --project ./tsconfig.build.json",
    "casbin:migrate": "node --env-file=.env --import=tsx ./script/casbin.migrate.ts",
    "db": "npm run db:generate && npm run db:migrate && npm run elasticsearch:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import=tsx ./script/drizzle.migrate.ts",
    "dev": "npm run dev:pre && (npm run dev:tsc & npm run dev:esbuild & npm run dev:node)",
    "dev:bun": "NODE_ENV=development bun run --env-file=.env --inspect=0.0.0.0:9229 --preload=source-map-support/register --watch ./build/app.js",
    "dev:deno": "NODE_ENV=development deno --allow-all --inspect=0.0.0.0:9229 --watch ./build/app.deno.js",
    "dev:esbuild": "node --env-file=.env --import=tsx ./script/esbuild.dev.ts",
    "dev:node": "NODE_ENV=development node --env-file=.env --inspect=0.0.0.0:9229 --require=source-map-support/register --watch ./build/app.node.js",
    "dev:otel": "node --env-file=.env --import=tsx --import=./src/app.opentelemetry.ts --inspect=0.0.0.0:9229 --watch ./build/app.node.js",
    "dev:pre": "rimraf ./build/ && mkdir ./build/ && cp ./package.build.json ./build/package.json",
    "dev:sentry": "node --env-file=.env --import=tsx --import=./src/app.sentry.ts --inspect=0.0.0.0:9229 --watch ./build/app.node.js",
    "dev:tsc": "tsc --noEmit --preserveWatchOutput --project ./tsconfig.eslint.json --watch",
    "diagram": "npm run diagram:tsuml2",
    "diagram:tsuml2": "tsuml2 --glob \"./src/**/application/**/*.ts\" --memberAssociations --mermaid --nomnoml --outDsl=\"./doc/ARCHITECTURE.nomnoml\" --outFile=\"./doc/ARCHITECTURE.svg\" --outMermaidDsl=\"./doc/ARCHITECTURE.mermaid\" --tsconfig=\"./tsconfig.json\"",
    "docker:build": "npm run build:esbuild:pre && node --import=tsx ./script/esbuild.build.ts",
    "docker:db": "drizzle-kit generate && node --import=tsx ./script/drizzle.migrate.ts && node --import=tsx ./script/elasticsearch.migrate.ts",
    "docker:dev": "node --import=tsx --import=./src/app.opentelemetry.ts --inspect=0.0.0.0:9229 --watch ./build/app.node.js",
    "elasticsearch:migrate": "node --env-file=.env --import=tsx ./script/elasticsearch.migrate.ts",
    "lint:depcruise:baseline": "depcruise --config=./dependency-cruiser.config.js --do-not-follow=node_modules --output-type=baseline ./src/",
    "lint:depcruise:dot": "depcruise --config=./dependency-cruiser.config.js --exclude=node_modules --output-type=dot ./src/ | dot -Tsvg | depcruise-wrap-stream-in-html > ./doc/dependency-graph.html",
    "lint:depcruise:err": "depcruise --config=./dependency-cruiser.config.js --exclude=node_modules --output-type=err ./src/",
    "lint:swagger": "scalar validate http://127.0.0.1:8081/api/v1/reference/swagger.json",
    "openapi": "npm run openapi:generator-cli & npm run openapi:typescript & npm run openapi:zod-client",
    "openapi:generator-cli": "openapi-generator-cli generate --generator-name=markdown --input-spec=http://127.0.0.1:8081/api/v1/reference/swagger.json --output=./doc/openapi/",
    "openapi:typescript": "openapi-typescript --additional-properties --alphabetize http://127.0.0.1:8081/api/v1/reference/swagger.json --array-length --immutable --output=./doc/openapi/openapi.d.ts --path-params-as-types",
    "openapi:zod-client": "openapi-zod-client --output=./doc/openapi/openapi.client.ts --prettier=./doc/ http://127.0.0.1:8081/api/v1/reference/swagger.json",
    "plop": "plop --import=tsx --plopfile=plopfile.ts",
    "sentry:profiler": "sentry-prune-profiler-binaries --target_arch=x64 --target_dir_path=./build/ --target_node=20 --target_platform=linux --target_stdlib=musl",
    "start": "NODE_ENV=production node --env-file=.env ./build/app.node.js",
    "test": "rimraf ./coverage/ && npm run test:tsc && npm run test:vitest",
    "test:bun": "bun test .",
    "test:deno": "deno test --allow-all .",
    "test:tsc": "tsc --noEmit --project ./tsconfig.eslint.json",
    "test:vitest": "vitest ."
  },
  "type": "module",
  "types": "./build/app.d.ts",
  "version": "0.0.0"
}
