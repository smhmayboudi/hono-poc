{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src/"
  },
  "exclude": [
    "**/build/**",
    "**/coverage/**",
    "**/doc/**",
    "**/drizzle/**",
    "**/node_modules/**",
    "**/plop-template/**",
    "./src/**/*.test.ts"
  ],
  "extends": ["./tsconfig.json"],
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "references": []
}
