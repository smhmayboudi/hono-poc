  "scripts": {
    "build": "pnpm run build:esbuild",
    "build:esbuild": "pnpm run build:esbuild:pre && dotenvx run -- node ./script/esbuild.build.js",
    "build:esbuild:pre": "rimraf ./build/ && mkdir ./build/ && cp ./package.build.json ./build/package.json",
    "build:esbuild:pre-push": "pnpm run build:esbuild:pre && dotenvx run -- node ./script/esbuild.build.pre-push.js",
    "build:rollup": "pnpm run build:rollup:pre && pnpm exec rollup --config",
    "build:rollup:pre": "rimraf ./build/ && mkdir ./build/",
    "db": "pnpm run db:generate && pnpm run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenvx run -- node --import tsx ./script/drizzle.migrate.ts",
    "dev": "pnpm run dev:pre && (pnpm run dev:tsc & pnpm run dev:esbuild & pnpm run dev:node)",
    "dev:deno": "exit 0 || NODE_ENV=development dotenvx run -- deno --allow-all --inspect=0.0.0.0:9229 --watch ./src/app.deno.ts --require source-map-support/register",
    "dev:esbuild": "dotenvx run -- node ./script/esbuild.dev.js",
    "dev:node": "NODE_ENV=development dotenvx run -- node --inspect=0.0.0.0:9229 --require source-map-support/register --watch ./build/app.node.js",
    "dev:otel": "dotenvx run -- node --watch --import tsx --import ./src/app.opentelemetry.ts --trace-warnings ./src/app.node.ts",
    "dev:pre": "rimraf ./build/ && mkdir ./build/ && cp ./package.build.json ./build/package.json",
    "dev:tsc": "tsc --noEmit --preserveWatchOutput --watch",
    "diagram": "pnpm run diagram:tplant & pnpm run diagram:tsuml2",
    "diagram:tplant": "tplant --associations --input \"./src/**/application/**/*.ts\" --output ./doc/ARCHITECTURE.plantuml",
    "diagram:tsuml2": "tsuml2 --glob \"./src/**/application/**/*.ts\" --memberAssociations --mermaid --nomnoml --outDsl \"./doc/ARCHITECTURE.nomnoml\" --outFile \"./doc/ARCHITECTURE.svg\" --outMermaidDsl \"./doc/ARCHITECTURE.mermaid\" --tsconfig \"./tsconfig.json\"",
    "elasticsearch:migrate": "dotenvx run -- node --import tsx ./script/elasticsearch.migrate.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm run lint:es && pnpm run lint:ox && pnpm run lint:biome",
    "lint:biome": "biome check .",
    "lint:depcruise:baseline": "depcruise --config ./dependency-cruiser.config.js --do-not-follow node_modules --output-type baseline ./src/",
    "lint:depcruise:dot": "depcruise --config ./dependency-cruiser.config.js --exclude node_modules --output-type dot ./src/ | dot -Tsvg | depcruise-wrap-stream-in-html > ./doc/dependency-graph.html",
    "lint:depcruise:err": "depcruise --config ./dependency-cruiser.config.js --exclude node_modules --output-type err ./src/",
    "lint:es": "eslint .",
    "lint:ox": "oxlint .",
    "lint:swagger": "scalar validate http://127.0.0.1:8081/api/v1/swagger.json",
    "openapi": "pnpm run openapi:generator-cli & pnpm run openapi:typescript & pnpm run openapi:zod-client",
    "openapi:generator-cli": "openapi-generator-cli generate --generator-name markdown --input-spec http://127.0.0.1:8081/api/v1/swagger.json --output ./doc/openapi/",
    "openapi:typescript": "openapi-typescript --additional-properties --alphabetize http://127.0.0.1:8081/api/v1/swagger.json --array-length --immutable --output ./doc/openapi/openapi.d.ts --path-params-as-types",
    "openapi:zod-client": "openapi-zod-client --output ./doc/openapi/openapi.client.ts --prettier ./doc/ http://127.0.0.1:8081/api/v1/swagger.json",
    "prepare": "dotenvx run -- node ./script/husky.install.js",
    "sentry:profiler": "sentry-prune-profiler-binaries --target_arch=x64 --target_dir_path=./build/ --target_node=20 --target_platform=linux --target_stdlib=musl",
    "start": "NODE_ENV=production dotenvx run -- node ./build/app.node.js",
    "test": "rimraf ./coverage/ && pnpm run test:tsc && pnpm run test:bun && pnpm run test:deno && pnpm run test:vitest",
    "test:bun": "bun test .",
    "test:deno": "exit 0 || deno test --allow-all .",
    "test:tsc": "tsc --noEmit",
    "test:vitest": "vitest ."
  },
  "type": "module",
  "version": "0.0.0"
}
