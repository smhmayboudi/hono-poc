{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [
      "**/build/**",
      "**/coverage/**",
      "**/doc/**",
      "**/drizzle/**",
      "**/node_modules/**",
      "**/plop-template/**",
      "./tsconfig.base.json"
    ],
    "ignoreUnknown": true,
    "include": ["**/*.js", "**/*.json", "**/*.ts"]
  },
  "formatter": {
    "attributePosition": "auto",
    "enabled": true,
    "formatWithErrors": false,
    "ignore": ["package.json"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "jsxQuoteStyle": "double",
      "lineEnding": "lf",
      "lineWidth": 80,
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "all": true,
      "recommended": false,
      "style": {
        "noDefaultExport": "off",
        "noParameterProperties": "off",
        "useNamingConvention": "off"
      }
    }
  },
  "organizeImports": {
    "enabled": false
  },
  "overrides": [
    {
      "include": ["packages/backend/**/*.config.*"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend/**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/application/port/driven/*-create*.ts",
        "packages/backend/**/application/port/driven/*-delete*.ts",
        "packages/backend/**/application/port/driven/*-update*.ts",
        "packages/backend/**/application/port/driving/*-create.ts",
        "packages/backend/**/application/port/driving/*-delete.ts",
        "packages/backend/**/application/port/driving/*-disabled.ts",
        "packages/backend/**/application/port/driving/*-update.ts",
        "packages/backend/**/application/port/driving/*-upsert.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/auth/auth-logger.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/auth/auth-secondary-storage.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/casbin/casbin-drizzle-adapter.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/logger/logger.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/middleware/logger.test.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off",
            "useOptionalChain": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/middleware/logger.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useLiteralKeys": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/middleware/opentelemetry.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/adapter/opentelemetry/opentelemetry.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNamespaceImport": "off",
            "noNonNullAssertion": "off",
            "noParameterAssign": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/application/port/database/database.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/infrastructure/application/port/opentelemetry/opentelemetry.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend/**/shared/adapter/driven/request-query.ts"],
      "linter": {
        "rules": {
          "style": { "noParameterAssign": "off" }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/shared/adapter/driving/request-query.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noUselessElse": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/shared/adapter/driving/response/json-api.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/app.deno.ts",
        "packages/backend/**/app.env.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "noUselessElse": "off"
          }
        }
      }
    },
    {
      "include": [
        "packages/backend/**/app.node.ts",
        "packages/backend/**/app.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend/**/app.opentelemetry.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "style": {
            "noNamespaceImport": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend/**/app.sentry.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "style": {
            "noNamespaceImport": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend/plopfile.js"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend/script/*"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "noConsoleLog": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend-test/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "correctness": {
            "noUndeclaredDependencies": "off",
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "include": ["packages/backend-test/webpack.config.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noUndeclaredDependencies": "off"
          },
          "style": {
            "useNodejsImportProtocol": "off"
          }
        }
      }
    },
    {
      "include": ["script/husky.install.js"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "suspicious": {
            "noConsoleLog": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
