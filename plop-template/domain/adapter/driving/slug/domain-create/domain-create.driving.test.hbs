import { faker } from "@faker-js/faker";
import { OpenAPIHono } from "@hono/zod-openapi";
import { describe, expect, it, vi } from "vitest";
import { mock } from "vitest-mock-extended";

import type { Env } from "../../../../env.ts";
import type { PortConfig } from "../../../../infrastructure/config/config.ts";
import type { PortLogger } from "../../../../infrastructure/logger/logger.ts";
import type { PortSlug } from "../../../../infrastructure/slugify/slugify.ts";
import { honoDefaultHook } from "../../../../shared/util/hono-default-hook.ts";
import { objectPropertiesOmit } from "../../../../shared/util/object-properties-omit.ts";
import type { Domain{{pascalCase domain}} } from "../../../application/domain/{{kebabCase domain}}.ts";
import type { PortDriven{{pascalCase domain}}Create } from "../../../application/port/driven/{{kebabCase domain}}-create.ts";
import type { PortDriving{{pascalCase domain}}Update } from "../../../application/port/driving/{{kebabCase domain}}-update.ts";
import { UseCase{{pascalCase domain}}Create } from "../../../application/use-case/{{kebabCase domain}}-create.ts";
import { adapterDriving{{pascalCase domain}}Create } from "./{{kebabCase domain}}-create.driving.ts";

describe("{{pascalCase domain}} Driving Create", () => {
  const createMocks = () => {
    const config = mock<PortConfig>({});
    const id = faker.number.int();
    const nameEn = faker.person.fullName();
    const slug = mock<PortSlug>({ slugify: () => `${nameEn}-br-${id}` });
    const domain{{pascalCase domain}}: Domain{{pascalCase domain}} = {
      displayOrder: 999,
      id,
      isDeleted: false,
      nameAr: faker.person.fullName(),
      nameEn,
      originCountryCode: faker.location.countryCode(),
      slug: slug.slugify(),
    };
    const driven{{pascalCase domain}}Create = mock<PortDriven{{pascalCase domain}}Create>({
      create: vi.fn().mockReturnValue({ id }),
    });
    const driving{{pascalCase domain}}Update = mock<PortDriving{{pascalCase domain}}Update>({
      execute: vi.fn().mockReturnValue({ slug: slug.slugify() }),
    });
    const logger = mock<PortLogger>({ assign: vi.fn(), info: vi.fn() });
    const useCase{{pascalCase domain}}Create = new UseCase{{pascalCase domain}}Create(
      config,
      driven{{pascalCase domain}}Create,
      driving{{pascalCase domain}}Update,
      logger,
    );

    return {
      config,
      domain{{pascalCase domain}},
      id,
      logger,
      useCase{{pascalCase domain}}Create,
    };
  };

  it("should call post with correct data", async () => {
    expect.assertions(3);

    const { config, domain{{pascalCase domain}}, id, logger, useCase{{pascalCase domain}}Create } =
      await createMocks();
    const mockApp = new OpenAPIHono<Env>({ defaultHook: honoDefaultHook });
    const basePath = "/api/v1";
    const domainType = "{{kebabCase domain}}";
    adapterDriving{{pascalCase domain}}Create(
      mockApp,
      basePath,
      config,
      domainType,
      logger,
      useCase{{pascalCase domain}}Create,
    );
    const response = await mockApp.request(`${basePath}/${domainType}`, {
      body: JSON.stringify(objectPropertiesOmit(domain{{pascalCase domain}}, ["id", "slug"])),
      headers: [["Content-Type", "application/vnd.api+json"]],
      method: "POST",
    });

    expect(response).not.toBeNull();
    await expect(response.json()).resolves.toStrictEqual({
      data: {
        attributes: domain{{pascalCase domain}},
        id: String(id),
        links: {
          self: `http://localhost/{{kebabCase domain}}/${id}`,
        },
        type: "{{kebabCase domain}}",
      },
    });
    expect(response.status).toBe(200);
  });
});
