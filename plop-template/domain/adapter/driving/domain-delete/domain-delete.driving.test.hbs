import { faker } from "@faker-js/faker";
import { OpenAPIHono } from "@hono/zod-openapi";
import { describe, expect, it, vi } from "vitest";
import { mock } from "vitest-mock-extended";

import type { Env } from "../../../../env.ts";
import type { PortConfig } from "../../../../infrastructure/config/config.ts";
import type { PortLogger } from "../../../../infrastructure/logger/logger.ts";
import { honoDefaultHook } from "../../../../shared/util/hono-default-hook.ts";
import type { Domain{{pascalCase domain}} } from "../../../application/domain/{{kebabCase domain}}.ts";
import type { PortDriven{{pascalCase domain}}Delete } from "../../../application/port/driven/{{kebabCase domain}}-delete.ts";
import { UseCase{{pascalCase domain}}Delete } from "../../../application/use-case/{{kebabCase domain}}-delete.ts";
import { adapterDriving{{pascalCase domain}}Delete } from "./{{kebabCase domain}}-delete.driving.ts";

describe("{{pascalCase domain}} Driving Delete", () => {
  const deleteMocks = () => {
  const config = mock<PortConfig>({});
  const id = faker.number.int();
    const domain{{pascalCase domain}}: Domain{{pascalCase domain}} = {
      age: faker.number.int({ min: 1, max: 99 }).toString(),
      email: faker.internet.email(),
      id,
      name: faker.person.fullName(),
    };
    const driven{{pascalCase domain}}Delete = mock<PortDriven{{pascalCase domain}}Delete>({
      delete: vi.fn().mockReturnValue({ id }),
    });
    const logger = mock<PortLogger>({ assign: vi.fn(), info: vi.fn() });
    const useCase{{pascalCase domain}}Delete = new UseCase{{pascalCase domain}}Delete(
      config,
      driven{{pascalCase domain}}Delete,
      logger,
    );

    return {
      config,
      domain{{pascalCase domain}},
      logger,
      useCase{{pascalCase domain}}Delete,
    };
  };

  it("should call post with correct data", async () => {
    expect.assertions(3);

    const { config, domain{{pascalCase domain}}, logger, useCase{{pascalCase domain}}Delete } = await deleteMocks();
    const mockApp = new OpenAPIHono<Env>({ defaultHook: honoDefaultHook });
    const basePath = "/api/v1";
    const domainType = "{{kebabCase domain}}";
    adapterDriving{{pascalCase domain}}Delete(
      mockApp,
      basePath,
      config,
      domainType,
      logger,
      useCase{{pascalCase domain}}Delete,
    );
    const response = await mockApp.request(
      `${basePath}/${domainType}/${domain{{pascalCase domain}}.id}`,
      {
        headers: [["Content-Type", "application/vnd.api+json"]],
        method: "DELETE",
      },
    );

    expect(response).not.toBeNull();
    await expect(response.json()).resolves.toStrictEqual({
      data: {
        attributes: { id: domain{{pascalCase domain}}.id },
        id: String(domain{{pascalCase domain}}.id),
        links: {
          self: `http://localhost/{{kebabCase domain}}/${domain{{pascalCase domain}}.id}`,
        },
        type: "{{kebabCase domain}}",
      },
    });
    expect(response.status).toBe(200);
  });
});
